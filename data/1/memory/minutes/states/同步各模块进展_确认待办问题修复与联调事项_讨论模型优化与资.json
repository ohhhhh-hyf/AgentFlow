      "time": "2026-09-08"
    },
    {
      "type": "decision_added",
      "item_id": "d12",
      "kind": "decision",
      "text": "长文本问题改配置，但token慢，需优化。",
      "meeting_id": "m_a3574fe6223c4acab87b51377c3751d6",
      "time": "2026-09-08"
    },
    {
      "type": "decision_added",
      "item_id": "d13",
      "kind": "decision",
      "text": "930节点前优先提升千问模型并发，至少单卡四并发。",
      "meeting_id": "m_a3574fe6223c4acab87b51377c3751d6",
      "time": "2026-09-08"
    },
    {
      "type": "decision_added",
      "item_id": "d14",
      "kind": "decision",
      "text": "most方案暂缓，集中人力做千问并发优化。",
      "meeting_id": "m_a3574fe6223c4acab87b51377c3751d6",
      "time": "2026-09-08"
    },
    {
      "type": "superseded",
      "item_id": "d15",
      "kind": "decision",
      "text": "非实时方案暂缓，先做实时方案。",
      "meeting_id": "m_a3574fe6223c4acab87b51377c3751d6",
      "time": "2026-09-08"
    },
