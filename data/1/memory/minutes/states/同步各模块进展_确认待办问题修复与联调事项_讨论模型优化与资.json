      "time": "2026-09-01"
    },
    {
      "type": "risk_added",
      "item_id": "r2",
      "kind": "risk",
      "text": "模型并发资源需求大，10路并发需12卡，资源申请可能困难。",
      "meeting_id": "m_769e9d32dbae4ad6a3f363fbd16fbca8",
