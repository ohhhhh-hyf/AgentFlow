  "events": [
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "decision_added",
      "text": "8月18日前林夏继续优化minutes_trace的场景匹配、模板输出要求和证据对齐策略，目标是用户关键点和笔记在不捏造事实的前提下尽可能挂上。"
    },
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "decision_added",
      "text": "赵衡在8月19日前补齐记忆引用的来源字段，包括历史会议时间、会议名称、类型和关联对象。"
    },
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "decision_added",
      "text": "钱屿在8月20日前把Gradio界面中minutes_trace的模板入口彻底移除，并保留关键点、笔记上传入口。"
    },
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "decision_added",
      "text": "陈澄在8月21日前准备一组前后两场会议的记忆测试样例，重点验证第二场是否能接住第一场的项目进展。"
    },
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "risk_added",
      "text": "记忆能力已可用，但可解释性还不够像用户产品。"
    },
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "risk_added",
      "text": "minutes_trace的证据挂载如果太少，会削弱用户对溯源纪要的信任。"
    },
    {
      "seq": 1,
      "at": "2026-08-31 14:59:08",
      "type": "item_opened",
      "text": "是否在内测版默认开启记忆引用下划线展示，还是先作为实验开关提供。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "decision_added",
      "text": "minutes_trace不再支持用户自定义模板，后续只走场景匹配和通用兜底模板。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "decision_added",
      "text": "记忆引用默认采用正文下划线加底部历史会议来源，文案尽量改成用户能理解的“来自历史会议”，不要暴露“记忆1”这类编号。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "decision_added",
      "text": "Gradio界面目前可以进入内测候选，但下划线hover提示和底部来源文案还要再打磨。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "decision_added",
      "text": "测试侧8月20日前完成三类回归：会议纪要记忆、溯源纪要、笔记知识图谱。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "risk_added",
      "text": "如果用户笔记是情绪化批注，模型有时会把批注原样带得太重，需要再控制语气。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "risk_added",
      "text": "有一条历史风险被过度关联到了行动项里。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "risk_added",
      "text": "内测主要风险从“功能不可用”转为“用户是否理解并信任”。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "risk_added",
      "text": "如果下划线标记太多，用户可能觉得正文被打扰；如果标记太少，又看不出历史记忆的价值。"
    },
    {
      "seq": 2,
      "at": "2026-08-31 15:00:15",
      "type": "risk_mitigated",
      "text": "记忆能力已可用，但可解释性还不够像用户产品。"
    },
