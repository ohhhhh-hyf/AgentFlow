# 知识库 Embedding（硅基流动）+ 分块参数
SILICONFLOW_API_KEY=sk-lwshjzqubvprqpznxacrypvfrymxbijaykxkmlytfwlltawy
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
