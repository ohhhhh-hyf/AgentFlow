# OCR 引擎：serverocr=服务器优先并兜底 RapidOCR；rapidocr=本地测试直接 RapidOCR
OCR_ENGINE=paddleocr
PADDLE_OCR_DEVICE=gpu:0
PADDLE_OCR_CUDA_VISIBLE_DEVICES=2

#服务器 OCR 接口（CLI 使用 --engine serverocr 时生效；上服务器后取消注释）
