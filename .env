# Redis：异步任务接口（POST/GET /api/v1/tasks）的任务状态 + 事件流 + 全局发号器
# 本机 Redis / Docker 映射 6379 时保持默认即可；换库/换机/加密码改这一行
REDIS_URL=redis://0.0.0.0:6379/0
# 异步任务执行模式：inline=API 进程内跑（缺省，起个 uvicorn 就能用）；
# queue=提交只落盘+入队，由 python -m app.worker 消费执行（生产主路径）
AGENTFLOW_RUN_MODE=inline
#AGENTFLOW_RUN_MODE=queue
# ── 队列参数（仅 queue 模式生效；取消注释即覆盖默认值）──
# 单个 worker 进程的并发槽位数；全局并发 = 所有 worker 之和（默认 1）
#AGENTFLOW_WORKER_CONCURRENCY=4
# 收到停机信号后等待在跑任务收尾的秒数，需大于最长任务耗时（默认 300）
#AGENTFLOW_WORKER_GRACE=300
# 执行租约时长：超时未续期即判定 worker 失联并回收（默认 60）
#AGENTFLOW_LEASE_SECONDS=60
# 心跳续期间隔，需显著小于租约时长（默认 10）
#AGENTFLOW_HEARTBEAT_SECONDS=10
# 单个任务最多执行几次，含首次；输入类错误（4xx）不重试（默认 2）
#AGENTFLOW_JOB_MAX_ATTEMPTS=2

# 任务状态与事件流的过期秒数，默认 7 天（604800）；需要更短留存时取消注释
#AGENTFLOW_JOB_TTL_SECONDS=604800
