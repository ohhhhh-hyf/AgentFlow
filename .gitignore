.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.idea/

# 只忽略仓库根目录的记忆落盘，不要误伤 tools/memory 源码包
/memory/
.claude/
.reasonix/

.ocrvenv/

# codegraph index cache
.codegraph/
.cac/
.vscode/

# ── 运行时产物（本地跑出来的东西，不进版本库）──────────────────
# 保留 data/{user_id}/docs 等输入夹具；只忽略产物/记忆/知识库
data/*/memory/
data/*/knowledge/

# api_test 调用脚本下载下来的产物（*_get.py 落到各自 downloads/ 下）
api_test/**/downloads/

# 服务运行日志（tools.core.logging_config 落到 logs/）
/logs/
