.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.idea/

# 只忽略仓库根目录的记忆落盘，不要误伤 tools/memory 源码包
/memory/
.claude/
.reasonix/

.ocrvenv/

# codegraph index cache
.codegraph/
.cac/
.vscode/

# ── 运行时产物（本地跑出来的东西，不进版本库）──────────────────
# 保留 data/{user_id}/docs 等输入夹具；只忽略产物/记忆/知识库
data/*/memory/
data/*/knowledge/

# 任务产物（data/{user_id}/output/{request_id}/：result.md / *.html）
data/*/output/

# 服务日志（logs/agentflow.log、logs/diag.log、logs/ocr_failed/、logs/agenda_ocr/；按大小轮转）
logs/

# ZCode CLI 工作目录
.zcode/
