# 复制本文件为 .env 并填写你的真实 Key：
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env

# ── LLM 后端类型选择：http / websocket / vllm ─────────
# 1. DeepSeek 官方 HTTP（当前默认，使用 API Key）
LLM_BACKEND=http
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2

# 2. WebSocket OpenAI Chat Completions 兼容接口（切回用）
#LLM_BACKEND=websocket
#LLM_WS_URL=ws://10.32.101.24:18087/llm/websocket/openai/chat/completions
#LLM_WS_API_KEY=AccessService
#LLM_WS_SENDER=h00984725
#LLM_WS_USER=dudududux124erf8709e2
#LLM_WS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731/Cluster-1
#LLM_WS_TEMPERATURE=0.7
#LLM_WS_TOP_P=0.9
#LLM_WS_TOP_K=128
#LLM_WS_MAX_TOKENS=50000
#LLM_WS_STOP=DeepSeek
#LLM_WS_ENABLE_THINKING=false

# 3. 本地 / 服务器 vLLM OpenAI 兼容接口（切回用）
#LLM_BACKEND=vllm
#LLM_VLLM_BASE_URL=http://127.0.0.1:8000/v1
#LLM_VLLM_API_KEY=EMPTY
#LLM_VLLM_MODEL=deepseek-v4-flash-0731
#LLM_VLLM_TEMPERATURE=0.2


# ── 知识库 Embedding（硅基流动）+ 分块检索参数 ─────────
SILICONFLOW_API_KEY=your_siliconflow_api_key
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_TOP_K=6
KNOWLEDGE_MAX_TOKENS=1024


# ── OCR 驱动引擎配置 ───────────────────────────────────
# 取值：serverocr=服务器优先并兜底 RapidOCR；rapidocr=本地直接使用 RapidOCR
OCR_ENGINE=rapidocr

# 服务器 OCR 接口（CLI 使用 --engine serverocr 时生效；上服务器后取消注释）
#SERVER_OCR_URL=http://10.33.111.33:8080/service
#SERVER_OCR_TIMEOUT=120
#SERVER_OCR_REQUEST_ID=test
#SERVER_OCR_UUID=test
#SERVER_OCR_APPID=hiai
#SERVER_OCR_BID=test_focusocr_fun
#SERVER_OCR_FLOWID=test_focusocr_fun
#SERVER_OCR_LANGUAGE=AUTO
#SERVER_OCR_TEXT_SHAPE=curve_enable
#SERVER_OCR_SIGN_KEY=CB663177458347D19A07D03E7728C878D1C413811F0C4526AEDD26DDD4334980


# ── 异步任务队列与 Redis 存储配置 ──────────────────────
# Redis 连接地址（支持 REDIS_URL 或 AGENTFLOW_REDIS_URL，默认 redis://127.0.0.1:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0

# 异步任务执行模式（两种形式）：
# - inline（默认）：API 单进程内执行（BackgroundTasks），零外部依赖，本地/单机快速开发
# - queue：推入 Redis 队列，由独立 Worker 进程消费（python -m app.worker.main），支持分布式与高并发
AGENTFLOW_RUN_MODE=inline

# 任务快照与事件流在 Redis 中的保存时长（秒，默认 7 天）
AGENTFLOW_JOB_TTL_SECONDS=604800

# 异步任务失败最大重试次数（默认 2 次）
AGENTFLOW_JOB_MAX_ATTEMPTS=2

# 分布式 Worker 租约与心跳超时（秒）
AGENTFLOW_LEASE_SECONDS=60
AGENTFLOW_HEARTBEAT_SECONDS=10


# ── 系统结构化日志配置 ─────────────────────────────────
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_LOG_FILE=logs/agentflow.log
AGENTFLOW_DIAG_LOG_FILE=logs/diag.log
