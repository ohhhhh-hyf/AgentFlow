# ── 大模型后端类型选择: http (DeepSeek 官方) / vllm (服务器私有部署) ──
LLM_BACKEND=http
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60.0

# ── 本地 / 服务器 vLLM OpenAI 兼容接口（切回用） ──
#LLM_BACKEND=vllm
#LLM_VLLM_BASE_URL=http://127.0.0.1:8000/v1
#LLM_VLLM_API_KEY=EMPTY
#LLM_VLLM_MODEL=deepseek-v4-flash-0731
#LLM_VLLM_TEMPERATURE=0.2

# ── 视觉议程识别 VLM 服务（可选） ──
#VLM_AGENDA_ENDPOINT=http://10.34.23.78:8888/predict
#VLM_AGENDA_SECRET=your_vlm_secret_key_here
#VLM_AGENDA_TIMEOUT=30.0

# ── 日志系统配置 ──
LOG_LEVEL=INFO
LOG_MAX_MB=20
LOG_BACKUPS=5
